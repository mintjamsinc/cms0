<?xml version="1.0" encoding="UTF-8"?>
<camel>

    <!--
        Removes the Reversi rooms that are due: those that ended more than
        KEEP_ENDED_DAYS ago, and those still waiting, getting ready or playing
        in which nothing happened for KEEP_IDLE_DAYS (webtop.reversi.ReversiApi).
        The players of an idle room are told it is gone.

        A pass runs after a room was created: the repository posts
        javax/jcr/Node/ADDED for the room's settings file, rooms/<room>/.room.
        The aggregate turns a burst of them into one pass, two seconds after
        the last. Every cluster node receives the event, so a pass takes the
        lock file first, and a pass that finds it held - on this node or
        another - steps back: the pass holding it is already at work.

        The lock is scoped to the pass's session and released when its context
        closes. It is taken for a short lease and renewed as the pass goes
        through the rooms, so a pass that died lets it go within one lease; a
        pass whose lease passed to another stops.
    -->
    <route id="webtop-reversi-cleanup">
        <routeProperty key="mi:history" value="failure"/>
        <from id="webtop-reversi-cleanup-events" uri="eventadmin:javax/jcr/Node/ADDED?filter=(path=/var/lib/games/reversi/rooms/*/.room)&amp;maxQueueSize=1000&amp;rejectedPolicy=Discard"/>

        <aggregate id="webtop-reversi-cleanup-once" aggregationStrategy="#class:org.apache.camel.processor.aggregate.UseLatestAggregationStrategy" completionTimeout="2000">
            <correlationExpression><constant>all</constant></correlationExpression>

            <setProperty id="webtop-reversi-cleanup-run-as" name="runAs">
                <constant>games-service-user</constant>
            </setProperty>
            <setProperty id="webtop-reversi-cleanup-lock-file-path" name="lockFilePath">
                <constant>/var/lock/games/reversi/queue.cleanup.lock</constant>
            </setProperty>
            <!-- The lease, in seconds: sized for looking at a few rooms, as the
                 pass renews it while it goes. -->
            <setProperty id="webtop-reversi-cleanup-lock-timeout" name="lockTimeoutSeconds">
                <constant>60</constant>
            </setProperty>

            <doTry id="webtop-reversi-cleanup-try">
                <script id="webtop-reversi-cleanup-login">
                    <groovy>
                    <![CDATA[
                        def context = ScriptAPI.createServiceUserContext(exchange.getProperty('runAs'));
                        exchange.setProperty('mi:cms.context', context);
                    ]]>
                    </groovy>
                </script>

                <doTry id="webtop-reversi-cleanup-claim">
                    <script id="webtop-reversi-cleanup-lock">
                        <groovy>
                        <![CDATA[
                            def lockFilePath = exchange.getProperty('lockFilePath') as String;
                            def lockFile = context.session.getResource(lockFilePath);
                            if (!lockFile.exists()) {
                                // Two nodes may create it at once; the one whose commit
                                // fails finds it there and goes on to lock it.
                                try {
                                    lockFile.createFile();
                                    context.session.commit();
                                } catch (Throwable ignore) {
                                    context.session.rollback();
                                }
                            }
                            lockFile.lock(false, true, exchange.getProperty('lockTimeoutSeconds') as long);
                            exchange.setProperty('passLock', lockFile.getLock());
                        ]]>
                        </groovy>
                    </script>
                    <doCatch id="webtop-reversi-cleanup-held">
                        <exception>javax.jcr.lock.LockException</exception>
                        <log id="webtop-reversi-cleanup-skip" loggingLevel="DEBUG" message="Pass skipped, the lock at ${exchangeProperty.lockFilePath} is held by another pass"/>
                        <stop id="webtop-reversi-cleanup-skip-stop"/>
                    </doCatch>
                    <doCatch id="webtop-reversi-cleanup-claim-failed">
                        <exception>java.lang.Exception</exception>
                        <log id="webtop-reversi-cleanup-claim-log" loggingLevel="ERROR" message="${exception.message} ${exception.stacktrace}"/>
                        <stop id="webtop-reversi-cleanup-claim-stop"/>
                    </doCatch>
                </doTry>

                <script id="webtop-reversi-cleanup-purge">
                    <groovy>
                    <![CDATA[
                        def passLock = exchange.getProperty('passLock');
                        long leaseMillis = (exchange.getProperty('lockTimeoutSeconds') as long) * 1000L;
                        long renewedAt = System.currentTimeMillis();
                        int removed = webtop.reversi.ReversiApi.purge(context) {
                            // Renewed once a third of the lease has gone by. A lease
                            // that passed to another pass throws, and this pass stops.
                            long now = System.currentTimeMillis();
                            if ((now - renewedAt) >= leaseMillis.intdiv(3)) {
                                passLock.refresh();
                                renewedAt = now;
                            }
                        };
                        if (removed > 0) {
                            log.info("Removed ${removed} Reversi room(s) that were due".toString());
                        }
                    ]]>
                    </groovy>
                </script>

                <doCatch id="webtop-reversi-cleanup-catch">
                    <exception>java.lang.Exception</exception>
                    <log id="webtop-reversi-cleanup-log" loggingLevel="ERROR" message="${exception.message} ${exception.stacktrace}"/>
                    <script id="webtop-reversi-cleanup-rollback">
                        <groovy>
                        <![CDATA[
                            try {
                                context.session.rollback();
                            } catch (Throwable ignore) {}
                        ]]>
                        </groovy>
                    </script>
                    <throwException id="webtop-reversi-cleanup-rethrow" exceptionType="java.lang.IllegalStateException" message="${exception.message}"/>
                </doCatch>

                <doFinally id="webtop-reversi-cleanup-finally">
                    <script id="webtop-reversi-cleanup-logout">
                        <groovy>
                        <![CDATA[
                            // Closing the context releases the lock. The property goes
                            // first: a closed context left on it has no bindings for a
                            // script that runs after this one.
                            def cmsContext = exchange.getProperty('mi:cms.context');
                            exchange.removeProperty('mi:cms.context');
                            cmsContext?.close();
                        ]]>
                        </groovy>
                    </script>
                </doFinally>
            </doTry>
        </aggregate>
    </route>

</camel>
