<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_chat_maintenance" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Removes old chat messages, and the conversations of files that are
       gone, in this workspace. Nothing in the chat is removed on its own; an
       administrator runs this when it is time (webtop.chat.ChatMaintenance).

       Flow: the start form (administrators only; the form hides the button
       for everyone else, the script enforces it) asks what to remove and how
       many days to keep, and starts this process. The service task runs the
       maintenance as the chat service user, which owns the chat area; it
       removes whole day folders, each committed on its own, so a stopped run
       keeps what it removed. The result user task shows the initiator the
       counts and ends the process when completed.

       The formKeys use {{lastModified}}, not ${...}: Camunda evaluates task
       formKeys as JUEL (which would swallow ${...}), while the tasks app
       substitutes {{...}} itself for cache busting. -->

  <bpmn:error id="Error_chat_unauthorized" name="ChatMaintenanceUnauthorized"
              errorCode="chat.maintenance.unauthorized"/>

  <bpmn:process id="chat-maintenance" name="Chat Maintenance" isExecutable="true">
    <bpmn:startEvent id="StartEvent_maintenance" name="Maintenance requested"
                     camunda:formKey="cms:/etc/bpm/forms/webtop/chat/start.html?t={{lastModified}}"
                     camunda:initiator="initiator">
      <bpmn:outgoing>Flow_start_run</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ServiceTask_run" name="Remove old messages"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/webtop/chat/maintain.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,targets,keepDays,orphans</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>result</camunda:string>
        </camunda:field>
        <!-- The chat area is owned by the chat service user; nobody else can
             remove anything under it. The authorization gate inside the script
             checks the initiator. -->
        <camunda:field name="runAs">
          <camunda:string>chat-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_run</bpmn:incoming>
      <bpmn:outgoing>Flow_run_result</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- A non-administrator who bypassed the form's display gate lands here:
         the script throws the unauthorized BpmnError and the process ends
         without having removed anything. -->
    <bpmn:boundaryEvent id="Boundary_unauthorized" name="Unauthorized"
                        attachedToRef="ServiceTask_run">
      <bpmn:outgoing>Flow_unauthorized_end</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_unauthorized" errorRef="Error_chat_unauthorized"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="UserTask_result" name="Chat Maintenance Result"
                   camunda:formKey="cms:/etc/bpm/forms/webtop/chat/result.html?t={{lastModified}}"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_run_result</bpmn:incoming>
      <bpmn:outgoing>Flow_result_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:endEvent id="EndEvent_done" name="Done">
      <bpmn:incoming>Flow_result_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_unauthorized" name="Rejected">
      <bpmn:incoming>Flow_unauthorized_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_run" sourceRef="StartEvent_maintenance" targetRef="ServiceTask_run"/>
    <bpmn:sequenceFlow id="Flow_run_result" sourceRef="ServiceTask_run" targetRef="UserTask_result"/>
    <bpmn:sequenceFlow id="Flow_result_end" sourceRef="UserTask_result" targetRef="EndEvent_done"/>
    <bpmn:sequenceFlow id="Flow_unauthorized_end" sourceRef="Boundary_unauthorized" targetRef="EndEvent_unauthorized"/>
  </bpmn:process>
</bpmn:definitions>
