<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_package_uninstall" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Uninstalls installed packages from this workspace from the Tasks app,
       several at a time.

       Flow: the start form (administrators only; the form hides the button
       for everyone else, the scripts enforce it) lists the installed packages
       (Query.installedPackages), lets the initiator pick, checks the
       selection as it changes (Query.packageUninstallInspection: everything
       selected is installed, nothing that stays requires it, what its
       recorded files look like now) and, when the initiator decides to
       uninstall, starts this process with the ids. Starting the process is
       the decision. The dispatch service task validates the initiator's
       administrator role and queues the uninstallation as a background job
       (PackageAPI.requestUninstall) - then returns immediately. The job
       checks the selection again and removes the packages together.

       The progress user task stays with the initiator: its form watches the
       job via the jobProgress subscription, can abort it, and on completion
       either closes the process (action=close, the gateway's default) or
       loops back to dispatch the uninstallation again (action=rerun) after a
       failure.

       The formKeys use {{lastModified}}, not ${...}: Camunda evaluates task
       formKeys as JUEL (which would swallow ${...}), while the tasks app
       substitutes {{...}} itself for cache busting.

       Progress is deliberately NOT kept in process variables - every
       variable write emits Camunda history. The job writes progress and its
       result to its /var/jobs record only; the process carries just the
       selected ids and the job id. -->

  <bpmn:error id="Error_packages_uninstall_unauthorized" name="PackageUninstallUnauthorized"
              errorCode="packages.install.unauthorized"/>

  <bpmn:process id="package-uninstall" name="Uninstall Packages" isExecutable="true">
    <bpmn:startEvent id="StartEvent_uninstall" name="Uninstallation decided"
                     camunda:formKey="cms:/etc/bpm/forms/system/packages/uninstall-start.html?t={{lastModified}}"
                     camunda:initiator="initiator">
      <bpmn:outgoing>Flow_start_dispatch</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ServiceTask_dispatch" name="Dispatch Uninstallation"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/system/packages/uninstall-dispatch.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,packageIds</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>jobId</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>package-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_dispatch</bpmn:incoming>
      <bpmn:incoming>Flow_rerun_dispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_dispatch_progress</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- A non-administrator who bypassed the form's display gate lands here:
         the script throws the unauthorized BpmnError and the process ends
         without having touched anything. -->
    <bpmn:boundaryEvent id="Boundary_unauthorized" name="Unauthorized"
                        attachedToRef="ServiceTask_dispatch">
      <bpmn:outgoing>Flow_unauthorized_end</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_unauthorized" errorRef="Error_packages_uninstall_unauthorized"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="UserTask_progress" name="Package Uninstallation Progress"
                   camunda:formKey="cms:/etc/bpm/forms/system/packages/progress.html?t={{lastModified}}"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_dispatch_progress</bpmn:incoming>
      <bpmn:outgoing>Flow_progress_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_action" name="Action?" default="Flow_close_end">
      <bpmn:incoming>Flow_progress_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_rerun_dispatch</bpmn:outgoing>
      <bpmn:outgoing>Flow_close_end</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:endEvent id="EndEvent_done" name="Closed">
      <bpmn:incoming>Flow_close_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_unauthorized" name="Rejected">
      <bpmn:incoming>Flow_unauthorized_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_dispatch" sourceRef="StartEvent_uninstall" targetRef="ServiceTask_dispatch"/>
    <bpmn:sequenceFlow id="Flow_dispatch_progress" sourceRef="ServiceTask_dispatch" targetRef="UserTask_progress"/>
    <bpmn:sequenceFlow id="Flow_progress_gateway" sourceRef="UserTask_progress" targetRef="Gateway_action"/>
    <bpmn:sequenceFlow id="Flow_rerun_dispatch" name="rerun" sourceRef="Gateway_action" targetRef="ServiceTask_dispatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'rerun'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_close_end" name="close" sourceRef="Gateway_action" targetRef="EndEvent_done"/>
    <bpmn:sequenceFlow id="Flow_unauthorized_end" sourceRef="Boundary_unauthorized" targetRef="EndEvent_unauthorized"/>
  </bpmn:process>
</bpmn:definitions>
