<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_package_install" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Installs a package (a ZIP with package.yml, deploy/ and provisioning/)
       into this workspace from the Tasks app.

       Flow: the start form (administrators only; the form hides the button
       for everyone else, the scripts enforce it) uploads the package to the
       staging area and starts this process. The inspect service task reads
       the package and runs the checks (PackageAPI.inspect); the confirm user
       task shows the initiator what the package is, what installing it would
       do and what the checks found, and asks for the decision. On "install"
       the install service task installs it (PackageAPI.install) and the
       result user task shows what was done; otherwise the staged package is
       discarded. The staged package is removed on every path.

       The service tasks run asynchronously so the forms return at once and
       the work runs on the job executor. They run as package-service-user,
       which only needs to read the scripts: the installer itself acts for
       the initiator, whose administrator role PackageAPI checks again.

       The formKeys use {{lastModified}}, not ${...}: Camunda evaluates task
       formKeys as JUEL (which would swallow ${...}), while the tasks app
       substitutes {{...}} itself for cache busting. -->

  <bpmn:error id="Error_packages_unauthorized" name="PackageInstallUnauthorized"
              errorCode="packages.install.unauthorized"/>

  <bpmn:process id="package-install" name="Install Package" isExecutable="true">
    <bpmn:startEvent id="StartEvent_install" name="Package uploaded"
                     camunda:formKey="cms:/etc/bpm/forms/system/packages/start.html?t={{lastModified}}"
                     camunda:initiator="initiator">
      <bpmn:outgoing>Flow_start_inspect</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ServiceTask_inspect" name="Inspect Package"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/system/packages/inspect.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,packagePath,packageFileName</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>inspection,inspectionOk,packageId,packageTitle,packageVersion</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>package-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_inspect_confirm</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- A non-administrator who bypassed the form's display gate lands here:
         the script throws the unauthorized BpmnError and the process ends
         without having read the package. -->
    <bpmn:boundaryEvent id="Boundary_unauthorized" name="Unauthorized"
                        attachedToRef="ServiceTask_inspect">
      <bpmn:outgoing>Flow_unauthorized_end</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_unauthorized" errorRef="Error_packages_unauthorized"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="UserTask_confirm" name="Confirm Package Installation"
                   camunda:formKey="cms:/etc/bpm/forms/system/packages/confirm.html?t={{lastModified}}"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_inspect_confirm</bpmn:incoming>
      <bpmn:outgoing>Flow_confirm_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_decision" name="Decision?" default="Flow_cancel_discard">
      <bpmn:incoming>Flow_confirm_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_install</bpmn:outgoing>
      <bpmn:outgoing>Flow_cancel_discard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="ServiceTask_install" name="Install Package"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/system/packages/install.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,packagePath,packageFileName</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>installResult,installError</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>package-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_install</bpmn:incoming>
      <bpmn:outgoing>Flow_install_result</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:userTask id="UserTask_result" name="Package Installation Result"
                   camunda:formKey="cms:/etc/bpm/forms/system/packages/result.html?t={{lastModified}}"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_install_result</bpmn:incoming>
      <bpmn:outgoing>Flow_result_end</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="ServiceTask_discard" name="Discard Package"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate"
                      camunda:asyncBefore="true">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/system/packages/discard.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,packagePath</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>package-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_cancel_discard</bpmn:incoming>
      <bpmn:outgoing>Flow_discard_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_installed" name="Installed">
      <bpmn:incoming>Flow_result_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_cancelled" name="Cancelled">
      <bpmn:incoming>Flow_discard_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_unauthorized" name="Rejected">
      <bpmn:incoming>Flow_unauthorized_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_inspect" sourceRef="StartEvent_install" targetRef="ServiceTask_inspect"/>
    <bpmn:sequenceFlow id="Flow_inspect_confirm" sourceRef="ServiceTask_inspect" targetRef="UserTask_confirm"/>
    <bpmn:sequenceFlow id="Flow_confirm_gateway" sourceRef="UserTask_confirm" targetRef="Gateway_decision"/>
    <bpmn:sequenceFlow id="Flow_install" name="install" sourceRef="Gateway_decision" targetRef="ServiceTask_install">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decision == 'install'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_cancel_discard" name="cancel" sourceRef="Gateway_decision" targetRef="ServiceTask_discard"/>
    <bpmn:sequenceFlow id="Flow_install_result" sourceRef="ServiceTask_install" targetRef="UserTask_result"/>
    <bpmn:sequenceFlow id="Flow_result_end" sourceRef="UserTask_result" targetRef="EndEvent_installed"/>
    <bpmn:sequenceFlow id="Flow_discard_end" sourceRef="ServiceTask_discard" targetRef="EndEvent_cancelled"/>
    <bpmn:sequenceFlow id="Flow_unauthorized_end" sourceRef="Boundary_unauthorized" targetRef="EndEvent_unauthorized"/>
  </bpmn:process>
</bpmn:definitions>
