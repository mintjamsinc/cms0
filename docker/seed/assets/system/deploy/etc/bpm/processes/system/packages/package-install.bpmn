<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_package_install" targetNamespace="http://bpmn.io/schema/bpmn">
  <!-- Installs a package (a ZIP with package.yml, deploy/ and provisioning/)
       into this workspace from the Tasks app.

       Flow: the start form (administrators only; the form hides the button
       for everyone else, the scripts enforce it) uploads the package to the
       staging area, shows the inspection (Query.packageInspection: what the
       package is, what installing it does, what the checks found) and, when
       the initiator decides to install, starts this process with the
       inspected file's sha256. Starting the process is the decision. The
       dispatch service task validates the initiator's administrator role and
       queues the installation as a background job (PackageAPI.requestInstall)
       - then returns immediately. The job inspects again, refuses a file
       whose sha256 differs from the one shown, and installs.

       The progress user task stays with the initiator: its form watches the
       job via the jobProgress subscription, can abort it, and on completion
       either closes the process (action=close, the gateway's default, which
       discards the staged package on the way out) or loops back to dispatch
       the installation again (action=rerun) after a failure.

       The formKeys use {{lastModified}}, not ${...}: Camunda evaluates task
       formKeys as JUEL (which would swallow ${...}), while the tasks app
       substitutes {{...}} itself for cache busting.

       Progress is deliberately NOT kept in process variables - every
       variable write emits Camunda history. The job writes progress and its
       result to its /var/jobs record only; the process carries just the
       start form's inputs and the job id. -->

  <bpmn:error id="Error_packages_unauthorized" name="PackageInstallUnauthorized"
              errorCode="packages.install.unauthorized"/>

  <bpmn:process id="package-install" name="Install Package" isExecutable="true">
    <bpmn:startEvent id="StartEvent_install" name="Installation decided"
                     camunda:formKey="cms:/etc/bpm/forms/system/packages/start.html?t={{lastModified}}"
                     camunda:initiator="initiator">
      <bpmn:outgoing>Flow_start_dispatch</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="ServiceTask_dispatch" name="Dispatch Installation"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/system/packages/dispatch.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,packagePath,packageFileName,packageSha256</camunda:string>
        </camunda:field>
        <camunda:field name="outputs">
          <camunda:string>jobId</camunda:string>
        </camunda:field>
        <!-- Without runAs the script would be evaluated as guest, which cannot
             even read the script resource. The service account only needs
             jcr:read on the script folder (see provisioning/packages.yml);
             the authorization gate inside the script checks the initiator. -->
        <camunda:field name="runAs">
          <camunda:string>package-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_dispatch</bpmn:incoming>
      <bpmn:incoming>Flow_rerun_dispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_dispatch_progress</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- A non-administrator who bypassed the form's display gate lands here:
         the dispatch throws the unauthorized BpmnError and the process ends
         without having queued anything. -->
    <bpmn:boundaryEvent id="Boundary_unauthorized" name="Unauthorized"
                        attachedToRef="ServiceTask_dispatch">
      <!-- The BPMN XSD orders an event's children: incoming/outgoing first,
           eventDefinition last. -->
      <bpmn:outgoing>Flow_unauthorized_end</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_unauthorized" errorRef="Error_packages_unauthorized"/>
    </bpmn:boundaryEvent>

    <bpmn:userTask id="UserTask_progress" name="Package Installation Progress"
                   camunda:formKey="cms:/etc/bpm/forms/system/packages/progress.html?t={{lastModified}}"
                   camunda:assignee="${initiator}">
      <bpmn:incoming>Flow_dispatch_progress</bpmn:incoming>
      <bpmn:outgoing>Flow_progress_gateway</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:exclusiveGateway id="Gateway_action" name="Action?" default="Flow_close_discard">
      <bpmn:incoming>Flow_progress_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_rerun_dispatch</bpmn:outgoing>
      <bpmn:outgoing>Flow_close_discard</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <!-- The staged package is only needed while the progress task lives:
         the re-run path installs it again. Once the initiator completes the
         task it is removed here, whatever the outcome. -->
    <bpmn:serviceTask id="ServiceTask_discard" name="Discard Package"
                      camunda:class="org.mintjams.script.bpm.CmsDelegate">
      <bpmn:extensionElements>
        <camunda:field name="path">
          <camunda:string>/etc/bpm/scripts/system/packages/discard.groovy</camunda:string>
        </camunda:field>
        <camunda:field name="inputs">
          <camunda:string>initiator,packagePath</camunda:string>
        </camunda:field>
        <camunda:field name="runAs">
          <camunda:string>package-service-user</camunda:string>
        </camunda:field>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_close_discard</bpmn:incoming>
      <bpmn:outgoing>Flow_discard_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_done" name="Closed">
      <bpmn:incoming>Flow_discard_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_unauthorized" name="Rejected">
      <bpmn:incoming>Flow_unauthorized_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_dispatch" sourceRef="StartEvent_install" targetRef="ServiceTask_dispatch"/>
    <bpmn:sequenceFlow id="Flow_dispatch_progress" sourceRef="ServiceTask_dispatch" targetRef="UserTask_progress"/>
    <bpmn:sequenceFlow id="Flow_progress_gateway" sourceRef="UserTask_progress" targetRef="Gateway_action"/>
    <bpmn:sequenceFlow id="Flow_rerun_dispatch" name="rerun" sourceRef="Gateway_action" targetRef="ServiceTask_dispatch">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${action == 'rerun'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_close_discard" name="close" sourceRef="Gateway_action" targetRef="ServiceTask_discard"/>
    <bpmn:sequenceFlow id="Flow_discard_end" sourceRef="ServiceTask_discard" targetRef="EndEvent_done"/>
    <bpmn:sequenceFlow id="Flow_unauthorized_end" sourceRef="Boundary_unauthorized" targetRef="EndEvent_unauthorized"/>
  </bpmn:process>
</bpmn:definitions>
