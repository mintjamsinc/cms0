Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %Plugin.name
Bundle-SymbolicName: org.mintjams.cms
Bundle-Vendor: %Plugin.provider
Bundle-Version: 1.0.0
Export-Package: org.mintjams.cms;version="1.0.0",
 org.mintjams.cms.config;version="1.0.0",
 org.mintjams.cms.security;version="1.0.0",
 org.mintjams.cms.security.mfa;version="1.0.0",
 org.mintjams.cms.security.saml2;version="1.0.0"
Import-Package: javax.jcr;version="2.0.0",
 javax.jcr.security;version="2.0.0",
 org.mintjams.jcr.security;version="[1.0.0,2.0.0)",
 org.mintjams.jcr.util;version="[1.0.0,2.0.0)",
 org.snakeyaml.engine.v2.api;version="2.3.0",
 org.snakeyaml.engine.v2.common;version="2.3.0"
Require-Bundle: bcpkix;bundle-version="1.83.0",
 bcprov;bundle-version="1.83.0",
 bcutil;bundle-version="1.83.0"
Automatic-Module-Name: org.mintjams.cms
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ActivationPolicy: lazy
Bundle-ClassPath: .
