# =============================================================================
# Platform BPM (Camunda 7) GraphQL schema — preview / side-by-side
# =============================================================================
# Contributed by PlatformBpmWiringContributor, merged into the same graphql-java
# schema as the core platform SDL (platform-schema.graphqls). It `extend`s the
# core Query/Mutation/Subscription roots and reuses the core scalars (Long,
# DateTime, JSON) and PageInfo type.
#
# This is the graphql-java migration target of the handmade BpmQueryExecutor /
# BpmMutationExecutor (Camunda 7), served at /bin/graphql.cgi. The
# per-workspace Camunda ProcessEngine is obtained exactly as the handmade engine
# does (CmsService.getWorkspaceProcessEngineProvider(ws).getProcessEngine()).
#
# Coverage:
#   Reads (complete): processDefinition(s), processDefinitionXml,
#     processInstance(s), activityHistory, task(s), taskCounts, incident(s).
#   Mutations: process instances — startProcess, suspend/activate/cancel/delete
#     ProcessInstance, setProcessVariables (BPM-2a); tasks — claim/unclaim/
#     assign/setAssignee/delegate/complete/setVariables/addComment (BPM-2b);
#     deployments/definitions — deployProcess, deleteDeployment, suspend/
#     activateProcessDefinition (BPM-2c); incidents — setJobRetries,
#     resolveIncident, setIncidentAnnotation (BPM-2d); migration —
#     createMigrationPlan, migrateProcessInstance (BPM-2e, async job).
#   Subscriptions: the platform-schema TaskEvent.task / ProcessEvent.
#     processInstance payloads are the typed Task / ProcessInstance (BPM-3).
# The BPM domain is complete (reads + mutations + typed subscription payloads).
#
# Reconciliation vs documents/GRAPHQL_SCHEMA.graphql: the heavy nested relations
# the Webtop never selects (ProcessDefinition.instances, ProcessInstance.
# definition/tasks/activityInstances) are omitted; startTime is nullable
# (formatDate may yield null) though the doc marks it non-null.
# =============================================================================

extend type Query {
  """A single process definition by id, or by key (latest, or a specific version)."""
  processDefinition(id: ID, key: String, version: Int): ProcessDefinition

  """Deployed process definitions (Relay connection)."""
  processDefinitions(first: Int = 100, after: String, key: String, name: String, latestVersion: Boolean, suspended: Boolean): ProcessDefinitionConnection!

  """The raw BPMN 2.0 XML of a process definition."""
  processDefinitionXml(id: ID!): String

  """A single process instance (active or historic) by id, with its variables."""
  processInstance(id: ID!): ProcessInstance

  """Process instances (active + historic; Relay connection)."""
  processInstances(first: Int = 20, after: String, definitionKey: String, definitionId: String, businessKey: String, active: Boolean, suspended: Boolean, withIncidents: Boolean, startedBefore: DateTime, startedAfter: DateTime): ProcessInstanceConnection!

  """Historic activity instances of a process instance, in start-time order."""
  activityHistory(processInstanceId: ID!): [ActivityInstance!]!
}

extend type Query {
  """A single task by id (with candidate users/groups and variables)."""
  task(id: ID!): Task

  """Tasks (Relay connection), with extensive filtering and sorting."""
  tasks(first: Int = 20, after: String, assignee: String, assigneeIn: [String!], candidateUser: String, candidateGroup: String, candidateGroups: [String!], unassigned: Boolean, processInstanceId: String, processDefinitionId: String, processDefinitionKey: String, taskDefinitionKey: String, dueBefore: DateTime, dueAfter: DateTime, createdBefore: DateTime, createdAfter: DateTime, priority: Int, priorityHigherThanOrEquals: Int, priorityLowerThanOrEquals: Int, sortBy: TaskSortField, sortOrder: SortOrder): TaskConnection!

  """
  Aggregate task counts for a dashboard (assignee or candidate scope).

  `timeZone` is the IANA time-zone name (e.g. `"Asia/Tokyo"`) in which the
  `dueToday` / `dueThisWeek` calendar-day boundaries are resolved, so the
  counts match the viewer's local "today"/"this week". When omitted — or when
  the name is malformed or unknown to the server's time-zone data — the
  boundaries are resolved in UTC, so the result never depends on the server's
  operating-system time zone and an unrecognised zone degrades gracefully
  rather than failing the whole query.
  """
  taskCounts(assignee: String, candidateUser: String, candidateGroups: [String!], timeZone: String): TaskCounts!
}

"""
Sort key for the `tasks` query. The resolver receives the enum constant name
(the same string the handmade engine accepted), so these map 1:1 to its Camunda
task-sort terms.
"""
enum TaskSortField {
  ID
  NAME
  ASSIGNEE
  CREATED
  DUE
  FOLLOW_UP
  PRIORITY
  PROCESS_INSTANCE_ID
}

"""Sort direction (ascending / descending)."""
enum SortOrder {
  ASC
  DESC
}

"""A Camunda user task. `name` is nullable (Camunda permits unnamed tasks)."""
type Task {
  id: ID!
  name: String
  description: String
  assignee: String
  """The display name of assignee; null when the user has none or no longer exists."""
  assigneeDisplayName: String
  owner: String
  created: DateTime
  due: DateTime
  followUp: DateTime
  priority: Int!
  suspended: Boolean!
  """
  The engine's optimistic-locking counter: increased by every change to the task
  itself (claim, assignment, due date, …) and by writes to its task-local
  variables, not by process-scoped variable writes or comments. Pass it back
  as `expectedRevision` so that a write based on an outdated view of the task is
  refused (CONFLICT) instead of overwriting what somebody else did meanwhile.
  """
  revision: Int
  processInstanceId: String!
  processDefinitionId: String!
  processDefinitionKey: String
  executionId: String!
  taskDefinitionKey: String!
  formKey: String
  """Parent process instance (embedded; businessKey is resolved via history)."""
  processInstance: ProcessInstance!
  candidateUsers: [String!]!
  candidateGroups: [String!]!
  variables: [ProcessVariable!]!
  localVariables: [ProcessVariable!]!
  """The Webtop app the process belongs to (the relPath of the app, from the process's `app` property); null when it names none."""
  app: String
  """The subject of the process (its `subject` property), with the values of the variables it names as they are now; null when it declares none."""
  subject: ProcessText
  """The latest record of the process: the last step somebody took, with the body written there; null when nothing is recorded."""
  latestRecord: ProcessRecord
  """The comments people wrote in the process, oldest first: at its tasks, and on the process itself. Select it for a single task, not for a list."""
  comments: [ProcessComment!]!
  """The latest comment written in the process; null when there is none."""
  latestComment: ProcessComment
}

"""
A subject or body of a process, as the reader's Webtop renders it: the
template as the BPMN writes it (text with `{{variable}}` placeholders), the i18n
key whose message replaces it in the reader's language when a bundle has one,
and the values of the variables it names. Dates are formatted in the reader's
time zone, so the text is never finished on the server.
"""
type ProcessText {
  """`bpm.process.<key>.subject`, `bpm.process.<key>.task.<taskDefinitionKey>.body` or `bpm.process.<key>.event.<activityId>.body`."""
  key: String!
  template: String!
  """`name -> { type, value }`; type is string, number, boolean or date (an ISO-8601 instant). A variable that is not set is left out."""
  params: JSON!
}

"""
A step somebody took in a process, as it was recorded: a start event that
declares a body (the process started), a user task that declares one (it was
completed), a throw or end event that declares one (it was reached: an outcome
such as "Approved"), a message event or receive task (always), or another
catch event that declares a body.
"""
type ProcessRecord {
  id: ID!
  time: DateTime
  """Who took the step: the authenticated user, else the task's assignee; null when nobody was signed in (a route, a timer)."""
  userId: String
  """The display name of userId; null when the user has none or no longer exists."""
  userDisplayName: String
  """The user task the record belongs to; null for any other step."""
  taskId: String
  activityId: String
  """startEvent, userTask, intermediateThrowEvent, endEvent, intermediateCatchEvent, boundaryEvent or receiveTask."""
  activityType: String
  """The step's name as the BPMN writes it (a task: the name it had)."""
  activityName: String
  """The body written at the step, with the values it showed then; null when the step declares none."""
  body: ProcessText
}

"""
A comment somebody wrote in a process (Camunda `TaskService.createComment`):
at a task - given with its completion, or left for whoever takes it over -
or on the process itself (`taskId` null), written by an app when it started
the process or told it something. Comments are kept at every history level
but `none` (see `processCommentsEnabled`).
"""
type ProcessComment {
  id: ID!
  time: DateTime
  """The writer: the engine's authenticated user when it was written; null when nobody was signed in."""
  userId: String
  """The display name of userId; null when the user has none or no longer exists."""
  userDisplayName: String
  """The task it was written at; null when it was written on the process."""
  taskId: String
  message: String!
}

type TaskConnection {
  edges: [TaskEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type TaskEdge {
  node: Task!
  cursor: String!
}

type TaskCounts {
  total: Int!
  unassigned: Int!
  assigned: Int!
  overdue: Int!
  dueToday: Int!
  dueThisWeek: Int!
}

extend type Query {
  """A single incident by id (stack trace included by default)."""
  incident(id: ID!, includeStackTrace: Boolean = true): Incident

  """Incidents (Relay connection); stack traces omitted unless requested."""
  incidents(first: Int = 50, after: String, processInstanceId: ID, processDefinitionId: String, processDefinitionKey: String, incidentType: String, activityId: String, includeStackTrace: Boolean = false): IncidentConnection!
}

"""A Camunda runtime incident. Most fields are nullable (incident kinds vary); jobId/jobRetries/stackTrace are populated for failedJob incidents."""
type Incident {
  id: ID!
  type: String!
  message: String
  incidentTimestamp: DateTime
  activityId: String
  """Falls back to activityId (display names are resolved client-side from the BPMN model)."""
  activityName: String
  executionId: String
  processInstanceId: String
  processDefinitionId: String
  processDefinitionKey: String
  jobId: String
  jobRetries: Int!
  causeIncidentId: String
  rootCauseIncidentId: String
  configuration: String
  annotation: String
  stackTrace: String
  tenantId: String
}

type IncidentConnection {
  edges: [IncidentEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type IncidentEdge {
  node: Incident!
  cursor: String!
}

# -----------------------------------------------------------------------------
# Mutations
# -----------------------------------------------------------------------------

extend type Mutation {
  """Start a process instance by definitionKey or definitionId, with variables."""
  startProcess(input: StartProcessInput!): ProcessInstance!

  """Suspend a process instance; returns the (historic) instance."""
  suspendProcessInstance(id: ID!): ProcessInstance

  """Activate a suspended process instance; returns the (historic) instance."""
  activateProcessInstance(id: ID!): ProcessInstance

  """Cancel (delete) a running process instance; returns true."""
  cancelProcessInstance(id: ID!, reason: String): Boolean!

  """Delete a process instance (optionally skipping custom listeners); returns true."""
  deleteProcessInstance(id: ID!, skipCustomListeners: Boolean): Boolean!

  """Replace a process instance's variables (REPLACE semantics: omitted names are removed)."""
  setProcessVariables(processInstanceId: ID!, variables: [ProcessVariableInput!]!): ProcessInstance
}

extend type Mutation {
  """
  Claim a task for the current (caller) user.

  `expectedRevision` (here and on the other task mutations that take it) is the
  `Task.revision` the caller last read: when the task has changed since, the
  call is refused with CONFLICT and nothing is written. Omitted, no such check
  is made.
  """
  claimTask(taskId: ID!, expectedRevision: Int): Task!

  """Release a claimed task (clears the assignee)."""
  unclaimTask(taskId: ID!, expectedRevision: Int): Task!

  """Assign a task to a specific user."""
  assignTask(taskId: ID!, assignee: String!): Task!

  """Set a task's assignee (null to unassign). Authorized for Admin, Supervisor, or the task's current assignee."""
  setTaskAssignee(taskId: ID!, assignee: String, expectedRevision: Int): Task!

  """Delegate a task to another user."""
  delegateTask(taskId: ID!, assignee: String!): Task!

  """
  Complete a task with optional variables. Returns minimal info (the task is gone after completion).

  Only the task's assignee may complete it; an unassigned task, or one assigned
  to somebody else, is refused (FORBIDDEN). An Admin or a Supervisor completing
  a task that is not theirs is made its assignee first, so the assignee kept in
  the history is always the user who completed the task. The check and the
  completion are one transaction; a change to the task landing in between, or
  an `input.expectedRevision` that is no longer current, fails with CONFLICT.
  """
  completeTask(input: CompleteTaskInput!): Task

  """Set variables on a task (local or process-scoped)."""
  setTaskVariables(taskId: ID!, variables: [ProcessVariableInput!]!, local: Boolean = false): Task!

  """
  Add a comment to a task, as the caller - a note for whoever takes it over;
  returns the created comment. Written by the task's assignee (an Admin or a
  Supervisor may write on any task). Refused when the workspace keeps no
  comments (`processCommentsEnabled` false).
  """
  addTaskComment(taskId: ID!, message: String!): TaskComment!
}

input CompleteTaskInput {
  taskId: ID!
  variables: [ProcessVariableInput!]
  """The `Task.revision` the caller last read; a task changed since is not completed (CONFLICT)."""
  expectedRevision: Int
  """
  A comment given with the completion, kept as a comment of the task written
  by the caller, in the same transaction as the completion. A process that
  needs the text (a script that passes it on) gets it as well as a variable
  marked transient (`valueInfo: {transient: true}`), which is never stored.
  Refused when the workspace keeps no comments (`processCommentsEnabled`
  false); empty or blank, none is written.
  """
  comment: String
  """Reserved (handmade parity): mutation-response variables are always empty; clients re-query the task."""
  withVariablesInReturn: Boolean = false
}

"""A task comment (Camunda createComment)."""
type TaskComment {
  id: ID!
  taskId: String!
  userId: String!
  time: DateTime!
  message: String!
}

extend type Mutation {
  """Deploy a process definition from one or more resources (BPMN XML, etc.)."""
  deployProcess(input: DeployProcessInput!): Deployment!

  """Delete a deployment (cascade removes its process instances and history)."""
  deleteDeployment(id: ID!, cascade: Boolean = false): Boolean!

  """Suspend a process definition (optionally its running instances); returns the updated definition."""
  suspendProcessDefinition(id: ID!, includeInstances: Boolean): ProcessDefinition

  """Activate a suspended process definition (optionally its instances); returns the updated definition."""
  activateProcessDefinition(id: ID!, includeInstances: Boolean): ProcessDefinition
}

type Deployment {
  id: ID!
  name: String
  deploymentTime: DateTime!
  source: String
  tenantId: String
}

input DeployProcessInput {
  name: String!
  source: String
  resources: [DeploymentResourceInput!]!
  """Accepted for schema compatibility; not applied (handmade parity)."""
  enableDuplicateFiltering: Boolean = false
  """Accepted for schema compatibility; not applied (handmade parity)."""
  deployChangedOnly: Boolean = false
}

input DeploymentResourceInput {
  name: String!
  content: String!
}

extend type Mutation {
  """Restore retries on the Job behind a failedJob incident (re-run on next executor cycle). Returns the refreshed incident."""
  setJobRetries(input: SetJobRetriesInput!): Incident

  """Resolve a custom incident (the engine rejects failedJob/failedExternalTask — use setJobRetries for those). Returns true."""
  resolveIncident(id: ID!): Boolean!

  """Set or clear (null/empty) an incident's operator annotation; returns the refreshed incident."""
  setIncidentAnnotation(input: SetIncidentAnnotationInput!): Incident
}

input SetJobRetriesInput {
  incidentId: ID!
  """Must be >= 1."""
  retries: Int!
  clearAnnotation: Boolean = false
}

input SetIncidentAnnotationInput {
  id: ID!
  annotation: String
}

extend type Mutation {
  """Build a migration plan preview (mapEqualActivities by default). The plan is not persisted until migrateProcessInstance runs."""
  createMigrationPlan(input: CreateMigrationPlanInput!): MigrationPlan!

  """Queue a process-instance migration as a CMS JobManager job; returns the job handle (subscribe to jobProgress(jobId))."""
  migrateProcessInstance(input: MigrateProcessInstanceInput!): MigrationJob!
}

"""A single source→target activity mapping in a migration plan."""
type MigrationInstruction {
  sourceActivityIds: [String!]!
  targetActivityIds: [String!]!
  updateEventTrigger: Boolean!
}

"""A built (not-yet-executed) migration plan preview."""
type MigrationPlan {
  sourceProcessDefinitionId: ID!
  targetProcessDefinitionId: ID!
  instructions: [MigrationInstruction!]!
}

"""A handle to a queued migration job; live progress arrives via jobProgress(jobId)."""
type MigrationJob {
  """CMS job id (NOT the Camunda batch id) — use as jobProgress(jobId:...)."""
  id: ID!
  """JobManager job type — `migrate-instances`."""
  jobType: String!
  """Initial job status (typically `queued`)."""
  status: String!
  """Always false for Camunda 7 (the batch cannot be safely cancelled mid-flight)."""
  abortable: Boolean!
}

input CreateMigrationPlanInput {
  sourceProcessDefinitionId: ID!
  targetProcessDefinitionId: ID!
  mapEqualActivities: Boolean = true
  updateEventTriggers: Boolean = false
}

input MigrateProcessInstanceInput {
  sourceProcessDefinitionId: ID!
  targetProcessDefinitionId: ID!
  """Either this or allActiveInstances must be supplied."""
  processInstanceIds: [ID!]
  allActiveInstances: Boolean = false
  mapEqualActivities: Boolean = true
  updateEventTriggers: Boolean = false
  skipCustomListeners: Boolean = false
  skipIoMappings: Boolean = false
}

"""A process/task variable to set. `value` is coerced to a Camunda typed value per `type` (String/Long/Integer/Double/Boolean/Date); a null/unparseable value yields a typed null."""
input ProcessVariableInput {
  name: String!
  type: String
  value: JSON!
  """
  `{transient: true}` sets a transient variable, as in Camunda's REST API:
  the process sees it until it next waits, and it is never stored nor kept
  in the history. A transient variable cannot take the name of a stored one
  of the same scope (the engine refuses it).
  """
  valueInfo: JSON
}

input StartProcessInput {
  definitionKey: String
  definitionId: String
  businessKey: String
  variables: [ProcessVariableInput!]
}

type ProcessDefinition {
  id: ID!
  key: String!
  name: String
  description: String
  version: Int!
  deploymentId: String!
  deploymentName: String
  resourceName: String
  diagramResourceName: String
  suspended: Boolean!
  category: String
  startFormKey: String
  """The Webtop app the process belongs to (its `app` property); null when it names none."""
  app: String
}

type ProcessInstance {
  id: ID!
  definitionId: String!
  definitionKey: String!
  businessKey: String
  suspended: Boolean!
  ended: Boolean!
  startTime: DateTime
  endTime: DateTime
  durationInMillis: Long
  incidentCount: Int!
  variables: [ProcessVariable!]!
}

"""A Camunda process/task variable. `value` is the variable's value (Date as ISO-8601, otherwise toString); `valueInfo` is reserved."""
type ProcessVariable {
  name: String!
  type: String!
  value: JSON
  valueInfo: JSON
}

type ActivityInstance {
  id: ID!
  activityId: String!
  activityName: String
  activityType: String!
  processInstanceId: String!
  startTime: DateTime
  endTime: DateTime
  durationInMillis: Long
  canceled: Boolean!
  completeScope: Boolean!
}

type ProcessDefinitionConnection {
  edges: [ProcessDefinitionEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type ProcessDefinitionEdge {
  node: ProcessDefinition!
  cursor: String!
}

type ProcessInstanceConnection {
  edges: [ProcessInstanceEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type ProcessInstanceEdge {
  node: ProcessInstance!
  cursor: String!
}

# -----------------------------------------------------------------------------
# Process history, scoped to the caller (the Tasks app's history view)
# -----------------------------------------------------------------------------

extend type Query {
  """What the caller may see of the process history."""
  processHistoryAccess: ProcessHistoryAccess!

  """
  Whether comments can be written in this workspace's processes (TaskService
  createComment): true at every history level but `none`, where the engine
  keeps no comments. Apps hide their comment fields when it is false.
  """
  processCommentsEnabled: Boolean!

  """
  Process instances, running and finished, newest first.

  The scope is enforced on the server from the caller's session. `MINE` (the
  default) is limited to the instances the caller started or held a task in -
  a task they claimed and released again, or passed on, included (below
  history level `audit`, only a task they were the last assignee of);
  `ALL` is refused (FORBIDDEN) unless the caller is an Admin or a Supervisor.
  Process variables are deliberately not part of this view: they carry what
  other participants entered. The only values shown are those the process
  author chose to show, by naming them in the subject and the bodies of the
  BPMN. At most the 1000 newest instances are considered.
  """
  processHistory(first: Int = 50, after: String, scope: ProcessHistoryScope = MINE, definitionKey: String, finished: Boolean, startedAfter: DateTime, startedBefore: DateTime): ProcessHistoryConnection!

  """A single history entry; null when it does not exist or the caller was not involved in it."""
  processHistoryEntry(id: ID!): ProcessHistoryEntry
}

enum ProcessHistoryScope {
  """The instances the caller started or held a task in."""
  MINE
  """Every instance of the workspace (Admin or Supervisor only)."""
  ALL
}

type ProcessHistoryAccess {
  """Whether the caller may ask for `scope: ALL`."""
  all: Boolean!
  """
  Whether the engine records who claimed, released, reassigned and completed
  each task (history level `audit` or `full`). When false,
  `ProcessHistoryStep.operations` is always empty; when true it is still empty
  for what ran before the operations were recorded.
  """
  operationsRecorded: Boolean!
}

type ProcessHistoryEntry {
  id: ID!
  definitionKey: String!
  definitionName: String
  definitionVersion: Int
  businessKey: String
  """The user who started the instance; null when it was started without one (e.g. by a route)."""
  startUserId: String
  """The display name of startUserId; null when the user has none or no longer exists."""
  startUserDisplayName: String
  startTime: DateTime
  endTime: DateTime
  durationInMillis: Long
  """ACTIVE, SUSPENDED, COMPLETED, EXTERNALLY_TERMINATED or INTERNALLY_TERMINATED."""
  state: String!
  """The instance's user tasks, in start order. Resolved on demand: select it for a single entry, not for a list."""
  steps: [ProcessHistoryStep!]!
  """The Webtop app the process belongs to (its `app` property); null when it names none."""
  app: String
  """The subject of the process, with the values as they are now (as they were at the end, once it ended); null when it declares none."""
  subject: ProcessText
  """The latest record of the process; null when nothing is recorded."""
  latestRecord: ProcessRecord
  """Every record of the process, oldest first. Resolved on demand: select it for a single entry, not for a list."""
  records: [ProcessRecord!]!
  """Every comment written in the process, oldest first: at its tasks and on the process itself. Select it for a single entry, not for a list."""
  comments: [ProcessComment!]!
  """The latest comment written in the process; null when there is none."""
  latestComment: ProcessComment
}

"""A user task of a process instance, as the history kept it."""
type ProcessHistoryStep {
  id: ID!
  taskDefinitionKey: String
  name: String
  """
  The task's assignee — for a finished task, the assignee when it ended. Tasks
  completed through this API were completed by that user; tasks completed by a
  route or a script, or before that rule existed, carry no such guarantee.
  """
  assignee: String
  """The display name of assignee; null when the user has none or no longer exists."""
  assigneeDisplayName: String
  startTime: DateTime
  endTime: DateTime
  durationInMillis: Long
  """ACTIVE, COMPLETED, or CANCELED (ended without being completed)."""
  state: String!
  """Who did what to the task, oldest first. Empty when nothing was recorded."""
  operations: [ProcessHistoryOperation!]!
}

"""An entry of the engine's user operation log for a task."""
type ProcessHistoryOperation {
  id: ID!
  time: DateTime
  userId: String
  """The display name of userId; null when the user has none or no longer exists."""
  userDisplayName: String
  """The engine's operation type: Claim (releasing a task is a Claim whose newValue is null), Assign, Complete, Delegate, Resolve, SetOwner, SetPriority, …"""
  type: String!
  property: String
  oldValue: String
  newValue: String
  """The display name of oldValue when property names a user (assignee, owner); null otherwise."""
  oldValueDisplayName: String
  """The display name of newValue when property names a user (assignee, owner); null otherwise."""
  newValueDisplayName: String
}

type ProcessHistoryConnection {
  edges: [ProcessHistoryEdge!]!
  pageInfo: PageInfo!
  totalCount: Int!
}

type ProcessHistoryEdge {
  node: ProcessHistoryEntry!
  cursor: String!
}
