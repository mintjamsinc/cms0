# =============================================================================
# Platform account-security GraphQL schema
# =============================================================================
# Contributed by PlatformSecurityWiringContributor, merged into the same
# graphql-java schema as the core platform SDL. It `extend`s the core
# Query/Mutation roots and reuses the core scalars (DateTime, JSON) and the
# IdP schema's IdpMutationError.
#
# Second factors (TOTP with backup codes, passkeys) are enrolled here; the
# identity provider verifies them at sign-in. The wiring authorizes the
# caller (a user manages their own factors; an administrator may inspect and
# remove anyone's) and delegates to the IdP's MultiFactorService, which keeps
# the secrets in the credential store. Steps that make a sign-in weaker or
# start a new enrollment ask for the caller's current password.
#
# Validation failures are returned in-band as an `errors` list; on success
# `errors` is null.
# =============================================================================

extend type Query {
  """The second-factor state of a user: the caller's own, or anyone's for an administrator. Null when the caller may not see it."""
  userSecurity(username: String!): UserSecurity
}

"""A user's enrolled second factors."""
type UserSecurity {
  username: String!
  """Whether a one-time password from an authenticator app is required after the password."""
  totpEnabled: Boolean!
  """Unused backup codes left; 0 when TOTP is off."""
  backupCodesRemaining: Int!
  """Whether this server is configured for passkeys."""
  passkeysAvailable: Boolean!
  passkeys: [Passkey!]!
}

"""A registered passkey (WebAuthn credential). `id` is opaque."""
type Passkey {
  id: String!
  displayName: String!
  created: DateTime
  lastUsed: DateTime
  """Authenticator transports reported at registration (usb, nfc, ble, internal, hybrid)."""
  transports: [String!]!
  """Whether the authenticator reports the passkey as backed up (synced)."""
  backedUp: Boolean!
}

extend type Mutation {
  """Start enrolling an authenticator app: returns the secret to show once (QR code / manual entry). Self only; requires the current password."""
  beginTotpEnrollment(input: BeginTotpEnrollmentInput!): TotpEnrollmentPayload!

  """Confirm the enrollment with a first code from the app; turns TOTP on and returns the backup codes (shown once)."""
  confirmTotpEnrollment(input: ConfirmTotpEnrollmentInput!): BackupCodesPayload!

  """Turn TOTP off and discard its secret and backup codes. Self with current password, or an administrator for another user."""
  disableTotp(input: DisableTotpInput!): UserSecurityPayload!

  """Replace the backup codes (shown once). Self only; requires the current password."""
  regenerateBackupCodes(input: RegenerateBackupCodesInput!): BackupCodesPayload!

  """Start registering a passkey: returns the PublicKeyCredentialCreationOptions (binary members base64url). Self only; requires the current password."""
  beginPasskeyRegistration(input: BeginPasskeyRegistrationInput!): PasskeyRegistrationPayload!

  """Finish registering a passkey with the credential the browser created (binary members base64url)."""
  finishPasskeyRegistration(input: FinishPasskeyRegistrationInput!): PasskeyPayload!

  """Rename a passkey. Self only."""
  renamePasskey(input: RenamePasskeyInput!): UserSecurityPayload!

  """Delete a passkey. Self with current password, or an administrator for another user."""
  deletePasskey(input: DeletePasskeyInput!): UserSecurityPayload!
}

input BeginTotpEnrollmentInput {
  username: String!
  currentPassword: String!
}

input ConfirmTotpEnrollmentInput {
  username: String!
  code: String!
}

input DisableTotpInput {
  username: String!
  """Required when disabling your own TOTP; ignored for an administrator acting on another user."""
  currentPassword: String
}

input RegenerateBackupCodesInput {
  username: String!
  currentPassword: String!
}

input BeginPasskeyRegistrationInput {
  username: String!
  currentPassword: String!
}

input FinishPasskeyRegistrationInput {
  username: String!
  """The PublicKeyCredential as JSON (id, rawId, type, authenticatorAttachment, response{clientDataJSON, attestationObject, transports})."""
  credential: JSON!
  displayName: String
}

input RenamePasskeyInput {
  username: String!
  id: String!
  displayName: String!
}

input DeletePasskeyInput {
  username: String!
  id: String!
  """Required when deleting your own passkey; ignored for an administrator acting on another user."""
  currentPassword: String
}

"""The secret of a TOTP enrollment in progress; shown to the user exactly once."""
type TotpEnrollmentPayload {
  """Base32 secret for manual entry."""
  secret: String
  """otpauth://totp/... URI for a QR code."""
  otpauthUri: String
  issuer: String
  accountName: String
  errors: [IdpMutationError!]
}

"""Freshly issued backup codes (plain text, shown once) and the refreshed state."""
type BackupCodesPayload {
  backupCodes: [String!]
  security: UserSecurity
  errors: [IdpMutationError!]
}

type UserSecurityPayload {
  security: UserSecurity
  errors: [IdpMutationError!]
}

"""Options for navigator.credentials.create(); `options` is null on error."""
type PasskeyRegistrationPayload {
  options: JSON
  errors: [IdpMutationError!]
}

type PasskeyPayload {
  passkey: Passkey
  security: UserSecurity
  errors: [IdpMutationError!]
}

# -----------------------------------------------------------------------------
# Sign-in methods and email address confirmation
#
# The IdP decides which first factors it offers (idp.yml `signIn`, the mail
# transport, the passkey relying party); `signInPolicy` reports that so that
# Preferences and Identity Manager can tell users what applies to them.
#
# When the server can send mail, a new email address is confirmed by a code
# sent to it before it is saved (beginMailChange / confirmMailChange); the
# address then carries User.mailVerifiedAt, and only such an address receives
# sign-in codes. An address an administrator enters waits as User.pendingMail
# for the same confirmation. Without a transport the address is saved at once
# and stays unverified.
# -----------------------------------------------------------------------------

extend type Query {
  """Which ways of signing in this server offers right now, and whether a changed email address is confirmed by a code."""
  signInPolicy: SignInPolicy!
}

enum SignInMethodState {
  """Offered on the sign-in page."""
  AVAILABLE
  """Switched off by the administrator."""
  DISABLED
  """Not possible in this installation (no mail transport, no passkey relying party)."""
  UNAVAILABLE
}

type SignInPolicy {
  """Username and password."""
  password: SignInMethodState!
  """A one-time code sent to the user's registered email address."""
  emailCode: SignInMethodState!
  """A passkey (WebAuthn)."""
  passkey: SignInMethodState!
  """Whether the server can send mail, so that a changed address is confirmed by a code before it is saved."""
  mailVerification: Boolean!
}

extend type Mutation {
  """Start changing the caller's email address. With a mail transport a code goes to the new address and the change waits for confirmMailChange; without one the address is saved at once (unverified). The same address may be given to confirm the current one."""
  beginMailChange(input: BeginMailChangeInput!): MailChangePayload!

  """Finish the change with the code that was sent: saves the address, marks it verified and drops any pendingMail."""
  confirmMailChange(input: ConfirmMailChangeInput!): UserMutationPayload!
}

input BeginMailChangeInput {
  mail: String!
  """Language of the message (ja or en); English when omitted."""
  lang: String
}

input ConfirmMailChangeInput {
  code: String!
}

type MailChangePayload {
  """True when a code was sent and confirmMailChange has to follow; false when the address was saved at once."""
  verificationRequired: Boolean!
  """Whether this call sent a message; false when one went out less than resendAfterSeconds ago (that code stays valid)."""
  sent: Boolean!
  expiresInSeconds: Int
  resendAfterSeconds: Int
  """The refreshed user when the address was saved at once."""
  user: User
  errors: [IdpMutationError!]
}
