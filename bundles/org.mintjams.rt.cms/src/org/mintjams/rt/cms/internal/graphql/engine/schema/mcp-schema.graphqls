# =============================================================================
# Platform MCP GraphQL schema
# =============================================================================
# Contributed by PlatformMcpWiringContributor, merged into the same
# graphql-java schema as the core platform SDL. It `extend`s the core
# Query/Mutation roots and reuses the core scalar DateTime.
#
# A user's MCP connection to the workspace this endpoint is bound to: whether
# MCP clients (such as Claude) may work in the workspace as that user. The
# user turns it on and off for themselves; while it is on, a client the user
# authorizes in the browser keeps working after the user signs out, until the
# connection is turned off. See documents/mcp-server.md.
# =============================================================================

extend type Query {
  """The caller's MCP connection to this workspace."""
  mcpConnection: McpConnection!
}

extend type Mutation {
  """Turn the caller's MCP connection to this workspace on or off, and set whether its clients may change content. Turning it off stops every client at once."""
  setMcpConnection(input: SetMcpConnectionInput!): McpConnection!
}

"""A user's MCP connection to a workspace."""
type McpConnection {
  """False when the MCP server is disabled on this server (mcp.yml). The connection cannot be turned on then."""
  available: Boolean!
  enabled: Boolean!
  """Whether the user lets clients change content."""
  write: Boolean!
  """False when this server keeps every connection read-only (mcp.yml#token.allowWrite); `write` then has no effect."""
  writeAllowed: Boolean!
  """When the connection was turned on; null while it is off."""
  enabledAt: DateTime
  """The label that tells this server from the user's others, when one is configured (mcp.yml#serverName). Null: go by the host name."""
  serverName: String
  """Path of the workspace's MCP endpoint on this server, e.g. /bin/mcp.cgi/web."""
  endpointPath: String!
  """The clients authorized since the connection was turned on, most recent first."""
  clients: [McpClient!]!
}

"""A client the user authorized."""
type McpClient {
  """The name the client registered under. It is the client's own claim."""
  name: String!
  """Where the authorization was delivered: the origin of the client's redirect URI."""
  redirectTarget: String!
  authorizedAt: DateTime!
}

input SetMcpConnectionInput {
  enabled: Boolean!
  """Whether clients may change content. Defaults to false."""
  write: Boolean
}

# -----------------------------------------------------------------------------
# The tools a workspace defines for itself: tools.yml files under /etc/graphql
# (and /content/WEB-INF/graphql), deployed file by file whenever one changes.
# The listing is how an author, or a client that just wrote a file, finds out
# what was deployed and what was not. See documents/mcp-server.md.
# -----------------------------------------------------------------------------

extend type Query {
  """The MCP tools this workspace defines in its tools.yml files, file by file, with what did not deploy and why."""
  mcpToolDeployments: [McpToolDeployment!]!
}

"""What became of one tools.yml."""
type McpToolDeployment {
  """The repository path of the file."""
  path: String!
  """When the tools now served from this file were deployed."""
  deployedAt: DateTime!
  """True when the file could not be read on the last attempt and the tools of its last good version are still served."""
  stale: Boolean!
  tools: [McpToolInfo!]!
  """What did not deploy, and why. Empty when everything did."""
  problems: [String!]!
}

"""One tool of a tools.yml."""
type McpToolInfo {
  name: String!
  title: String!
  """graphql or script."""
  kind: String!
  """read, write or destructive: whether the tool is offered to a read-only connection, and what a client is told it does."""
  access: String!
  """False for a tool its definition turns off (enabled: false); it is not served."""
  enabled: Boolean!
}
