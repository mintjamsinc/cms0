# Compiled class file
*.class

# Log file
#*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
# *.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/.project

# VS Code settings
.vscode/

# IntelliJ IDEA settings
.idea/

# Build output
build/
dist/

# Docker build output: assembled Felix runtime (third-party JARs + project
# bundles). Treated as a build artifact, not a source — distributed via the
# DockerHub image rather than committed.
/felix-dist/

# Docker seed: laid down by scripts/assemble-seed.* before a build — the
# Webtop, and the whole workspace tree (copied from system/).
/docker/seed/assets/system/deploy/usr/share/webtop/
/docker/seed/assets/workspace/
