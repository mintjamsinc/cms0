# Compiled class file
*.class

# Log file
#*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
# *.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
/.project

# VS Code settings
.vscode/

# IntelliJ IDEA settings
.idea/

# Docker build output: assembled Felix runtime (third-party JARs + project
# bundles). Treated as a build artifact, not a source — distributed via the
# DockerHub image rather than committed.
/felix-dist/

# Docker seed: the Webtop laid down by scripts/assemble-seed.* before a build.
/docker/seed/assets/*/deploy/usr/share/webtop/
/docker/seed/assets/workspace/deploy/etc/i18n/
/docker/seed/assets/workspace/deploy/content/WEB-INF/web.xml
/docker/seed/assets/workspace/deploy/provisioning/webtop.yml
/docker/seed/assets/workspace/deploy/etc/eip/routes/webtop/mail.xml
/docker/seed/assets/workspace/deploy/etc/graphql/webtop/mail/
/docker/seed/assets/workspace/deploy/usr/local/classes/webtop/mail/
/docker/seed/assets/workspace/deploy/provisioning/mail.yml
